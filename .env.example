# Supabase Dashboard → Project Settings → API
# The publishable/anon key is designed for browser use; RLS policies protect data.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME

# Legacy anon keys also work if the project still shows one instead of a publishable key:
# VITE_SUPABASE_ANON_KEY=eyJ_REPLACE_ME

# Never add SUPABASE_SERVICE_ROLE_KEY or a secret key to a VITE_* variable.

# Optional browser notifications: only the VAPID public key belongs in the frontend.
VITE_WEB_PUSH_PUBLIC_KEY=
# WEB_PUSH_PRIVATE_KEY and PUSH_DISPATCH_SECRET belong in Supabase Edge Function secrets.
