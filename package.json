{
  "name": "tiantufu-website",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "learning:dev": "vite --config vite.learning.config.ts --host 127.0.0.1 --port 5180 --strictPort --open /learning/interaction-atlas/index.html",
    "learning:build": "tsc -b && vite build --config vite.learning.config.ts",
    "learning:preview": "vite preview --config vite.learning.config.ts --host 127.0.0.1 --port 4180 --strictPort --open /learning/interaction-atlas/index.html",
    "test:learning": "node --experimental-strip-types tests/interaction-learning.regression.mjs",
    "test:learning-browser": "node tests/interaction-learning.browser.mjs",
    "test:design-motion": "node --experimental-strip-types tests/design-motion.regression.mjs",
    "test:design-studio": "node tests/page-motion.browser.mjs && node tests/design-studio.browser.mjs",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "test:accounts": "node --experimental-strip-types tests/accounts.regression.mjs",
    "test:cloud-security": "node tests/cloud-security.regression.mjs",
    "test:cloud-versions": "node --experimental-strip-types tests/cloud-version.regression.mjs",
    "test:shared-images": "node --experimental-strip-types tests/shared-images.regression.mjs",
    "test:browser-local": "node tests/browser-local.regression.mjs",
    "test:community": "node --experimental-strip-types tests/palace.regression.mjs && node --experimental-strip-types tests/photo-shelf.regression.mjs && node --experimental-strip-types tests/shelf-camera.regression.mjs && node tests/push-dispatch.regression.mjs",
    "test:community-browser": "node tests/community.browser.mjs",
    "test:community-db": "node tests/community-db.regression.mjs",
    "test:author-posts-db": "node tests/author-posts-db.regression.mjs",
    "test:author-studio-browser": "node tests/author-studio.browser.mjs",
    "test:email-registration-db": "node tests/email-registration-db.regression.mjs",
    "test:email-registration-browser": "node tests/email-registration.browser.mjs",
    "test:ui-texts": "node --experimental-strip-types tests/ui-text-fields.regression.mjs",
    "test:member-profiles": "node --experimental-strip-types tests/member-profile.regression.mjs && node --experimental-strip-types tests/member-gallery.regression.mjs",
    "test:circular-gallery": "node --experimental-strip-types tests/circular-gallery.regression.mjs",
    "test:map-motion": "node --experimental-strip-types tests/map-motion.regression.mjs && node --experimental-strip-types tests/map-viewport.regression.mjs",
    "test:core": "pnpm test:accounts && pnpm test:cloud-security && pnpm test:cloud-versions && pnpm test:shared-images && pnpm test:ui-texts && pnpm test:map-motion",
    "test": "node scripts/test-all.mjs",
    "push:keys": "node scripts/generate-push-keys.mjs",
    "push:local": "node scripts/activate-local-push.mjs",
    "push:preflight": "node scripts/push-preflight.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fontsource/geist": "^5.3.0",
    "@fontsource/noto-serif-sc": "^5.3.0",
    "@fontsource/playfair-display": "^5.3.0",
    "@gsap/react": "^2.1.2",
    "@supabase/supabase-js": "^2.117.2",
    "@tailwindcss/vite": "^4.3.3",
    "gsap": "^3.15.0",
    "lucide-react": "^1.49.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^4.3.3",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.11",
    "@types/node": "^24.13.3",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.0.4",
    "oxlint": "^1.75.0",
    "playwright": "1.62.1",
    "typescript": "~6.0.2",
    "vite": "^8.2.0"
  }
}
